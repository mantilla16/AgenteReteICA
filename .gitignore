__pycache__/
*.pyc
.pytest_cache/

# binario empaquetado (120MB, se genera con PyInstaller: ver lanzador.py) y
# salidas de prueba sueltas -- nunca pertenecen al repositorio
*.exe
# Andamiaje de PyInstaller. construir_exe.py lo borra al terminar, pero una
# limpieza que falla no puede acabar en un commit: build/ pesa 168MB y trae
# un .pkg de 125MB que GitHub rechaza. El .gitignore es la red, no la
# limpieza.
build/
*.spec
papel_reteica_*
!papel_reteica_*.xlsx
web/_muestra.json
_arranque_prueba.py

# Credenciales: el DSN de la base y la clave del SMTP viven en /etc/reteica.env
# en el servidor, nunca en el repositorio.
*.env
reteica.env
